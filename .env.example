# ---------------------------------------------------------------------------
# Deployment configuration (white-label)
#
# These have sensible defaults for the LANGRATIA deployment in src/config/index.ts,
# so you only need to set them when deploying for another client.
# ---------------------------------------------------------------------------

# Brand
VITE_BRAND_NAME=LANGRATIA
VITE_BRAND_FULL_NAME=LANGRATIA
VITE_PRODUCT_NAME=Leads
VITE_SITE_URL=https://langratia.com
VITE_SITE_DOMAIN=langratia.com

# Email identity (VITE_ values are client-side; the SENDER_/NOTIFICATION_ values
# are server-side and belong in the Cloudflare dashboard, not in git)
VITE_SENDER_EMAIL=inquiries@langratia.com
VITE_REPLY_TO_EMAIL=inquiries@langratia.com
VITE_DEFAULT_USER_EMAIL=sales@langratia.com
SENDER_EMAIL=inquiries@langratia.com
SENDER_NAME=LANGRATIA Inquiries
NOTIFICATION_EMAIL=inquiries@langratia.com

# Locale and currency
VITE_LOCALE=en-UG
VITE_CURRENCY=UGX
VITE_CURRENCY_DECIMALS=0

# Lead scoring — comma-separated, lowercased. Empty falls back to the defaults
# in src/config/index.ts.
VITE_TARGET_AREAS=kampala,ntinda,wakiso,entebbe,kawempe,makerere,muyenga,kansanga,bugolobi,nakawa,lugogo
VITE_TARGET_CATEGORIES=pharmacy,clinic,hospital,school,church,retail,hotel,restaurant,hardware,shop
